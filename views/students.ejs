<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students List</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css"
        integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
    <link rel="stylesheet" href="/showStudents.css">
</head>

<body>

    <div class="container"></div>

    <div class="card">

        <div class="header">
            <h2>📋 Students List</h2>

            <a href="/add-students" class="add-btn">
                + Add Student
            </a>
        </div>

        <% if(studentsData.length===0){ %>

            <div class="no-data">
                No students found.
            </div>

            <% } else { %>

                <div class="table-container">
                    <table>

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>First Name</th>
                                <th>Last Name</th>
                                <th>Age</th>
                                <th>Class</th>
                                <th>Roll No</th>
                                <th>Gender</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>

                            <% studentsData.forEach((student,index)=>{ %>

                                <tr>
                                    <td>
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <%= student.first_name %>
                                    </td>
                                    <td>
                                        <%= student.last_name %>
                                    </td>
                                    <td>
                                        <%= student.age %>
                                    </td>
                                    <td>
                                        <%= student.class %>
                                    </td>
                                    <td>
                                        <%= student.roll_number %>
                                    </td>
                                    <td>
                                        <%= student.gender %>
                                    </td>
                                    <td class="actions">
                                        <a href="/students/<%= student.id %>" class="btn view">
                                            👁 View
                                        </a>

                                        <a href="/update-students/<%= student.id %>" class="btn update">
                                            🖋 Update
                                        </a>


                                        <form action="/delete-student/<%= student._id %>?_method=DELETE" method="POST"
                                            style="display:inline;">
                                            <button type="submit" class="btn delete">
                                                🗑 Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
    </div>

    </div>
    <nav>
        <ul class="pagination justify-content-center mt-3 mr-5">
            <% var disabledClass = hasPrevPage ? "" : 'disabled'%>
                <li class="page-item <%= disabledClass%>">
                    <a class="page-link" href="/students/?page=<%= prevPage %>">Previous</a>
                </li>
                <% for(let i = 1; i <= totalPages; i++){ %>
                    <% var activeClass = currentPage == i ? "active" : "" %>
                    <li class="page-item <%=activeClass%>"><a class="page-link" href="/students/?page=<%= i%>"><%= i %></a></li>
                <% } %>
                <% var disabledClass2 = hasNextPage ? "" : 'disabled'%>
                <li class="page-item <%= disabledClass2%>">
                    <a class="page-link" href="/students/?page=<%= nextPage %>">Next</a>
                </li>
        </ul>
    </nav>

</body>

</html>